{
  "name": "redtrace-ui",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/run-web.mjs dev",
    "build": "node scripts/run-web.mjs build",
    "start": "node scripts/run-web.mjs start",
    "desktop:ui:dev": "vite --config vite.desktop.config.ts",
    "desktop:ui:build": "vite build --config vite.desktop.config.ts",
    "desktop:prepare": "node scripts/prepare-sidecar.mjs",
    "desktop:prepare:debug": "node scripts/prepare-sidecar.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/query-ui.test.mjs tests/live-ui.test.mjs tests/preferences-ui.test.mjs tests/suggestions-ui.test.mjs tests/time-ui.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern desktop-dist --ignore-pattern src-tauri/target --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "drizzle-orm": "0.45.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.47.0",
    "@cloudflare/workers-types": "^5.20261007.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.16",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "vinext": { "image-size": "2.0.3" },
    "miniflare": {
      "sharp": "0.35.5",
      "undici": "7.29.1"
    }
  },
  "type": "module"
}
